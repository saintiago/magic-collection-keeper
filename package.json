{
  "name": "magic-collection-keeper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test tests/*.test.js",
    "test:python": "node scripts/run-python-tests.mjs",
    "prepare:validation": "node scripts/prepare-validation.mjs",
    "build": "node scripts/build.mjs",
    "test:ui": "playwright test",
    "validate:docs": "node scripts/validate-docs.mjs",
    "validate": "npm run validate:docs && npm test && npm run test:python && npm run build && npm run test:ui"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1127.0",
    "@aws-sdk/lib-dynamodb": "^3.1127.0",
    "onnxruntime-web": "1.29.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.6"
  }
}
