{
  "name": "magic-collection-keeper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.11.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "migration:export": "esbuild scripts/migration/export-cli.ts --bundle --platform=node --format=esm --target=node24 --packages=external --outfile=.turbo/migration/export.mjs --log-level=warning && node .turbo/migration/export.mjs",
    "migration:prepare": "esbuild scripts/migration/cli.ts --bundle --platform=node --format=esm --target=node24 --packages=external --outfile=.turbo/migration/prepare.mjs --log-level=warning && node .turbo/migration/prepare.mjs",
    "build": "node -e \"require('node:fs').rmSync('build', { recursive: true, force: true })\" && tsc --project tsconfig.build.json",
    "package": "esbuild scripts/package-artifacts.ts --bundle --platform=node --format=esm --target=node24 --packages=external --outfile=.turbo/packaging/package-artifacts.mjs --log-level=warning && node .turbo/packaging/package-artifacts.mjs",
    "prepare:recognition": "esbuild scripts/prepare-recognition.ts --bundle --platform=node --format=esm --target=node24 --packages=external --outfile=.turbo/packaging/prepare-recognition.mjs --log-level=warning && node .turbo/packaging/prepare-recognition.mjs",
    "package:recognition": "esbuild scripts/package-recognition.ts --bundle --platform=node --format=esm --target=node24 --packages=external --outfile=.turbo/packaging/package-recognition.mjs --log-level=warning && node .turbo/packaging/package-recognition.mjs",
    "release:evidence": "esbuild scripts/release-evidence.ts --bundle --platform=node --format=esm --target=node24 --packages=external --outfile=.turbo/packaging/release-evidence.mjs --log-level=warning && node .turbo/packaging/release-evidence.mjs",
    "storybook": "esbuild scripts/start-storybook.ts --bundle --platform=node --format=esm --target=node24 --packages=external --outfile=.turbo/storybook/start.mjs --log-level=warning && node .turbo/storybook/start.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --cache --cache-location .turbo/eslint/.eslintcache --cache-strategy content",
    "lint:fix": "eslint . --fix",
    "lint:infrastructure": "node scripts/lint-infrastructure.ts",
    "typecheck": "tsc --noEmit",
    "boundaries": "depcruise src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:component": "vitest run --project component",
    "test:integration": "vitest run --project integration",
    "test:browser": "playwright test",
    "test:python": "node scripts/run-python-tests.ts",
    "test:recognition": "node --test tests/recognition/*.test.js",
    "install:browsers": "playwright install chromium",
    "validate": "turbo run format:check lint typecheck boundaries lint:infrastructure build test test:python test:recognition test:browser"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.4",
    "@types/pg": "^8.23.1",
    "dependency-cruiser": "^18.4.0",
    "embedded-postgres": "^18.4.0-beta.17",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "jszip": "^3.10.2",
    "onnxruntime-web": "1.29.0",
    "pg": "^8.23.0",
    "prettier": "^3.9.9",
    "turbo": "2.11.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@aws-sdk/client-rds-data": "^3.1141.0",
    "@aws-sdk/client-s3": "^3.1141.0",
    "zod": "^4.6.5"
  }
}
