{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Magic Collection Keeper rebuild foundation. Defines the isolated network, Aurora PostgreSQL cluster, retained buckets, Catalog and Recognition repositories, owner-specific reader/writer secrets, logs and alarms.",
  "Parameters": {
    "Environment": {
      "Type": "String",
      "AllowedValues": ["development", "test", "production"],
      "Description": "Deployment environment this stack defines. It names export values and pairs this stack with the service stack of the same environment."
    },
    "VpcCidr": {
      "Type": "String",
      "Default": "10.42.0.0/16",
      "AllowedPattern": "^\\d{1,3}(\\.\\d{1,3}){3}/(16|17|18|19|20|21|22)$",
      "Description": "IPv4 range of the isolated VPC. The stack carves four /24 subnets from it: two for tasks that need egress and two isolated database subnets. The range must be /22 or larger so all four subnets fit."
    },
    "DatabaseName": {
      "Type": "String",
      "Default": "keeper",
      "MinLength": 1,
      "MaxLength": 63,
      "AllowedPattern": "^[A-Za-z_][A-Za-z0-9_]{0,62}$",
      "Description": "Database inside the Aurora cluster that holds the authoritative Catalog and UserCards schemas."
    },
    "DatabaseEngineVersion": {
      "Type": "String",
      "Default": "17.10",
      "AllowedPattern": "^\\d+(\\.\\d+){0,2}$",
      "Description": "Aurora PostgreSQL engine version. Scaling to zero ACUs (auto-pause) requires 16.3, 15.7, 14.12 or 13.15 and later; update this pin deliberately."
    },
    "DatabaseMaximumCapacity": {
      "Type": "Number",
      "Default": 2,
      "AllowedValues": [1, 2, 4, 8, 16, 32, 64],
      "Description": "Highest Aurora Serverless v2 capacity in ACUs that the cluster may scale to under load."
    },
    "DatabaseAutoPauseSeconds": {
      "Type": "Number",
      "Default": 600,
      "MinValue": 300,
      "MaxValue": 86400,
      "Description": "Idle seconds before the Serverless v2 writer pauses at zero ACUs. The Data API resumes the cluster on the next request."
    },
    "DatabaseBackupRetentionDays": {
      "Type": "Number",
      "Default": 7,
      "MinValue": 1,
      "MaxValue": 35,
      "Description": "Days of automated Aurora backups kept inside the backup window."
    },
    "UserCardsWriterRoleName": {
      "Type": "String",
      "Default": "keeper_usercards_writer",
      "AllowedPattern": "^[a-z_][a-z0-9_]{0,62}$",
      "Description": "PostgreSQL role that owns UserCards private mutations. The schema bootstrap creates it with the generated password of the UserCards writer secret and grants it only the UserCards private schema; only the interactive API receives that credential."
    },
    "CatalogWriterRoleName": {
      "Type": "String",
      "Default": "keeper_catalog_writer",
      "AllowedPattern": "^[a-z_][a-z0-9_]{0,62}$",
      "Description": "PostgreSQL role that owns Catalog private mutations. The schema bootstrap creates it with the generated password of the Catalog writer secret and grants it only the Catalog private schema; only the finite catalog task receives that credential."
    },
    "SnapshotPrefix": {
      "Type": "String",
      "Default": "snapshots/",
      "AllowedPattern": "^([A-Za-z0-9!_.*'()/-]+/)?$",
      "Description": "Key prefix of the private source-snapshot bucket that the finite catalog job streams from."
    },
    "CatalogReaderRoleName": {
      "Type": "String",
      "Default": "keeper_catalog_reader",
      "AllowedPattern": "^[a-z_][a-z0-9_]{0,62}$",
      "Description": "PostgreSQL role that reads Catalog public views only."
    },
    "UserCardsReaderRoleName": {
      "Type": "String",
      "Default": "keeper_usercards_reader",
      "AllowedPattern": "^[a-z_][a-z0-9_]{0,62}$",
      "Description": "PostgreSQL role that reads account-scoped UserCards query views only."
    }
  },
  "Rules": {
    "DistinctDatabaseRoles": {
      "Assertions": [
        {
          "Assert": {
            "Fn::Not": [
              {
                "Fn::Equals": [
                  {
                    "Ref": "CatalogReaderRoleName"
                  },
                  {
                    "Ref": "CatalogWriterRoleName"
                  }
                ]
              }
            ]
          },
          "AssertDescription": "CatalogReaderRoleName and CatalogWriterRoleName must be different PostgreSQL roles."
        },
        {
          "Assert": {
            "Fn::Not": [
              {
                "Fn::Equals": [
                  {
                    "Ref": "CatalogReaderRoleName"
                  },
                  {
                    "Ref": "UserCardsReaderRoleName"
                  }
                ]
              }
            ]
          },
          "AssertDescription": "CatalogReaderRoleName and UserCardsReaderRoleName must be different PostgreSQL roles."
        },
        {
          "Assert": {
            "Fn::Not": [
              {
                "Fn::Equals": [
                  {
                    "Ref": "CatalogReaderRoleName"
                  },
                  {
                    "Ref": "UserCardsWriterRoleName"
                  }
                ]
              }
            ]
          },
          "AssertDescription": "CatalogReaderRoleName and UserCardsWriterRoleName must be different PostgreSQL roles."
        },
        {
          "Assert": {
            "Fn::Not": [
              {
                "Fn::Equals": [
                  {
                    "Ref": "CatalogWriterRoleName"
                  },
                  {
                    "Ref": "UserCardsReaderRoleName"
                  }
                ]
              }
            ]
          },
          "AssertDescription": "CatalogWriterRoleName and UserCardsReaderRoleName must be different PostgreSQL roles."
        },
        {
          "Assert": {
            "Fn::Not": [
              {
                "Fn::Equals": [
                  {
                    "Ref": "CatalogWriterRoleName"
                  },
                  {
                    "Ref": "UserCardsWriterRoleName"
                  }
                ]
              }
            ]
          },
          "AssertDescription": "CatalogWriterRoleName and UserCardsWriterRoleName must be different PostgreSQL roles."
        },
        {
          "Assert": {
            "Fn::Not": [
              {
                "Fn::Equals": [
                  {
                    "Ref": "UserCardsReaderRoleName"
                  },
                  {
                    "Ref": "UserCardsWriterRoleName"
                  }
                ]
              }
            ]
          },
          "AssertDescription": "UserCardsReaderRoleName and UserCardsWriterRoleName must be different PostgreSQL roles."
        }
      ]
    }
  },
  "Resources": {
    "Vpc": {
      "Type": "AWS::EC2::VPC",
      "Properties": {
        "CidrBlock": {
          "Ref": "VpcCidr"
        },
        "EnableDnsHostnames": true,
        "EnableDnsSupport": true,
        "Tags": [
          {
            "Key": "Name",
            "Value": {
              "Fn::Sub": "keeper-${Environment}-vpc"
            }
          },
          {
            "Key": "Environment",
            "Value": {
              "Ref": "Environment"
            }
          },
          {
            "Key": "Application",
            "Value": "magic-collection-keeper"
          }
        ]
      }
    },
    "InternetGateway": {
      "Type": "AWS::EC2::InternetGateway",
      "Properties": {
        "Tags": [
          {
            "Key": "Name",
            "Value": {
              "Fn::Sub": "keeper-${Environment}-igw"
            }
          },
          {
            "Key": "Environment",
            "Value": {
              "Ref": "Environment"
            }
          },
          {
            "Key": "Application",
            "Value": "magic-collection-keeper"
          }
        ]
      }
    },
    "InternetGatewayAttachment": {
      "Type": "AWS::EC2::VPCGatewayAttachment",
      "Properties": {
        "InternetGatewayId": {
          "Ref": "InternetGateway"
        },
        "VpcId": {
          "Ref": "Vpc"
        }
      }
    },
    "PublicRouteTable": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "Tags": [
          {
            "Key": "Name",
            "Value": {
              "Fn::Sub": "keeper-${Environment}-public"
            }
          },
          {
            "Key": "Environment",
            "Value": {
              "Ref": "Environment"
            }
          },
          {
            "Key": "Application",
            "Value": "magic-collection-keeper"
          }
        ]
      }
    },
    "PublicRoute": {
      "Type": "AWS::EC2::Route",
      "DependsOn": "InternetGatewayAttachment",
      "Properties": {
        "RouteTableId": {
          "Ref": "PublicRouteTable"
        },
        "DestinationCidrBlock": "0.0.0.0/0",
        "GatewayId": {
          "Ref": "InternetGateway"
        }
      }
    },
    "PublicSubnetA": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "AvailabilityZone": {
          "Fn::Select": [
            0,
            {
              "Fn::GetAZs": ""
            }
          ]
        },
        "CidrBlock": {
          "Fn::Select": [
            0,
            {
              "Fn::Cidr": [
                {
                  "Ref": "VpcCidr"
                },
                4,
                8
              ]
            }
          ]
        },
        "MapPublicIpOnLaunch": false,
        "Tags": [
          {
            "Key": "Name",
            "Value": {
              "Fn::Sub": "keeper-${Environment}-public-a"
            }
          },
          {
            "Key": "Environment",
            "Value": {
              "Ref": "Environment"
            }
          },
          {
            "Key": "Application",
            "Value": "magic-collection-keeper"
          }
        ]
      }
    },
    "PublicSubnetB": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "AvailabilityZone": {
          "Fn::Select": [
            1,
            {
              "Fn::GetAZs": ""
            }
          ]
        },
        "CidrBlock": {
          "Fn::Select": [
            1,
            {
              "Fn::Cidr": [
                {
                  "Ref": "VpcCidr"
                },
                4,
                8
              ]
            }
          ]
        },
        "MapPublicIpOnLaunch": false,
        "Tags": [
          {
            "Key": "Name",
            "Value": {
              "Fn::Sub": "keeper-${Environment}-public-b"
            }
          },
          {
            "Key": "Environment",
            "Value": {
              "Ref": "Environment"
            }
          },
          {
            "Key": "Application",
            "Value": "magic-collection-keeper"
          }
        ]
      }
    },
    "PublicSubnetARouteAssociation": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "RouteTableId": {
          "Ref": "PublicRouteTable"
        },
        "SubnetId": {
          "Ref": "PublicSubnetA"
        }
      }
    },
    "PublicSubnetBRouteAssociation": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "RouteTableId": {
          "Ref": "PublicRouteTable"
        },
        "SubnetId": {
          "Ref": "PublicSubnetB"
        }
      }
    },
    "DatabaseRouteTable": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "Tags": [
          {
            "Key": "Name",
            "Value": {
              "Fn::Sub": "keeper-${Environment}-database"
            }
          },
          {
            "Key": "Environment",
            "Value": {
              "Ref": "Environment"
            }
          },
          {
            "Key": "Application",
            "Value": "magic-collection-keeper"
          }
        ]
      }
    },
    "DatabaseSubnetA": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "AvailabilityZone": {
          "Fn::Select": [
            0,
            {
              "Fn::GetAZs": ""
            }
          ]
        },
        "CidrBlock": {
          "Fn::Select": [
            2,
            {
              "Fn::Cidr": [
                {
                  "Ref": "VpcCidr"
                },
                4,
                8
              ]
            }
          ]
        },
        "MapPublicIpOnLaunch": false,
        "Tags": [
          {
            "Key": "Name",
            "Value": {
              "Fn::Sub": "keeper-${Environment}-database-a"
            }
          },
          {
            "Key": "Environment",
            "Value": {
              "Ref": "Environment"
            }
          },
          {
            "Key": "Application",
            "Value": "magic-collection-keeper"
          }
        ]
      }
    },
    "DatabaseSubnetB": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": {
          "Ref": "Vpc"
        },
        "AvailabilityZone": {
          "Fn::Select": [
            1,
            {
              "Fn::GetAZs": ""
            }
          ]
        },
        "CidrBlock": {
          "Fn::Select": [
            3,
            {
              "Fn::Cidr": [
                {
                  "Ref": "VpcCidr"
                },
                4,
                8
              ]
            }
          ]
        },
        "MapPublicIpOnLaunch": false,
        "Tags": [
          {
            "Key": "Name",
            "Value": {
              "Fn::Sub": "keeper-${Environment}-database-b"
            }
          },
          {
            "Key": "Environment",
            "Value": {
              "Ref": "Environment"
            }
          },
          {
            "Key": "Application",
            "Value": "magic-collection-keeper"
          }
        ]
      }
    },
    "DatabaseSubnetARouteAssociation": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "RouteTableId": {
          "Ref": "DatabaseRouteTable"
        },
        "SubnetId": {
          "Ref": "DatabaseSubnetA"
        }
      }
    },
    "DatabaseSubnetBRouteAssociation": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "RouteTableId": {
          "Ref": "DatabaseRouteTable"
        },
        "SubnetId": {
          "Ref": "DatabaseSubnetB"
        }
      }
    },
    "DatabaseSubnetGroup": {
      "Type": "AWS::RDS::DBSubnetGroup",
      "Properties": {
        "DBSubnetGroupDescription": {
          "Fn::Sub": "Isolated database subnets of keeper-${Environment}: no route to the internet gateway or a NAT gateway"
        },
        "SubnetIds": [
          {
            "Ref": "DatabaseSubnetA"
          },
          {
            "Ref": "DatabaseSubnetB"
          }
        ],
        "Tags": [
          {
            "Key": "Environment",
            "Value": {
              "Ref": "Environment"
            }
          },
          {
            "Key": "Application",
            "Value": "magic-collection-keeper"
          }
        ]
      }
    },
    "DatabaseSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Aurora cluster of the rebuild: no client traffic; the IAM-authorized RDS Data API is the only path to the data",
        "VpcId": {
          "Ref": "Vpc"
        },
        "SecurityGroupEgress": [],
        "Tags": [
          {
            "Key": "Name",
            "Value": {
              "Fn::Sub": "keeper-${Environment}-database"
            }
          },
          {
            "Key": "Environment",
            "Value": {
              "Ref": "Environment"
            }
          },
          {
            "Key": "Application",
            "Value": "magic-collection-keeper"
          }
        ]
      }
    },
    "TaskSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Finite background jobs (catalog synchronization and Search indexing): outbound HTTPS only, no inbound rule",
        "VpcId": {
          "Ref": "Vpc"
        },
        "SecurityGroupEgress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 443,
            "ToPort": 443,
            "CidrIp": "0.0.0.0/0",
            "Description": "Amazon S3, RDS Data API, Amazon ECR and CloudWatch Logs endpoints"
          }
        ],
        "Tags": [
          {
            "Key": "Name",
            "Value": {
              "Fn::Sub": "keeper-${Environment}-finite-task"
            }
          },
          {
            "Key": "Environment",
            "Value": {
              "Ref": "Environment"
            }
          },
          {
            "Key": "Application",
            "Value": "magic-collection-keeper"
          }
        ]
      }
    },
    "DatabaseCluster": {
      "Type": "AWS::RDS::DBCluster",
      "DeletionPolicy": "Snapshot",
      "UpdateReplacePolicy": "Snapshot",
      "Properties": {
        "Engine": "aurora-postgresql",
        "EngineVersion": {
          "Ref": "DatabaseEngineVersion"
        },
        "DatabaseName": {
          "Ref": "DatabaseName"
        },
        "MasterUsername": "keeper_owner",
        "ManageMasterUserPassword": true,
        "EnableHttpEndpoint": true,
        "ServerlessV2ScalingConfiguration": {
          "MinCapacity": 0,
          "MaxCapacity": {
            "Ref": "DatabaseMaximumCapacity"
          },
          "SecondsUntilAutoPause": {
            "Ref": "DatabaseAutoPauseSeconds"
          }
        },
        "BackupRetentionPeriod": {
          "Ref": "DatabaseBackupRetentionDays"
        },
        "StorageEncrypted": true,
        "DeletionProtection": true,
        "CopyTagsToSnapshot": true,
        "EnableCloudwatchLogsExports": ["postgresql"],
        "DBSubnetGroupName": {
          "Ref": "DatabaseSubnetGroup"
        },
        "VpcSecurityGroupIds": [
          {
            "Ref": "DatabaseSecurityGroup"
          }
        ],
        "Tags": [
          {
            "Key": "Environment",
            "Value": {
              "Ref": "Environment"
            }
          },
          {
            "Key": "Application",
            "Value": "magic-collection-keeper"
          }
        ]
      }
    },
    "DatabaseInstance": {
      "Type": "AWS::RDS::DBInstance",
      "Properties": {
        "Engine": "aurora-postgresql",
        "DBInstanceClass": "db.serverless",
        "DBClusterIdentifier": {
          "Ref": "DatabaseCluster"
        },
        "PubliclyAccessible": false,
        "Tags": [
          {
            "Key": "Environment",
            "Value": {
              "Ref": "Environment"
            }
          },
          {
            "Key": "Application",
            "Value": "magic-collection-keeper"
          }
        ]
      }
    },
    "UserCardsWriterSecret": {
      "Type": "AWS::SecretsManager::Secret",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "Description": {
          "Fn::Sub": "UserCards private-mutation credential of the keeper-${Environment} Aurora cluster; only the interactive API consumes it through the RDS Data API"
        },
        "GenerateSecretString": {
          "SecretStringTemplate": {
            "Fn::Sub": "{\"username\":\"${UserCardsWriterRoleName}\"}"
          },
          "GenerateStringKey": "password",
          "PasswordLength": 32,
          "ExcludeCharacters": "\"@/\\"
        }
      }
    },
    "CatalogWriterSecret": {
      "Type": "AWS::SecretsManager::Secret",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "Description": {
          "Fn::Sub": "Catalog private-mutation credential of the keeper-${Environment} Aurora cluster; only the finite catalog task consumes it through the RDS Data API"
        },
        "GenerateSecretString": {
          "SecretStringTemplate": {
            "Fn::Sub": "{\"username\":\"${CatalogWriterRoleName}\"}"
          },
          "GenerateStringKey": "password",
          "PasswordLength": 32,
          "ExcludeCharacters": "\"@/\\"
        }
      }
    },
    "BrowserBucket": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "RetainExceptOnCreate",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "OwnershipControls": {
          "Rules": [
            {
              "ObjectOwnership": "BucketOwnerEnforced"
            }
          ]
        },
        "VersioningConfiguration": {
          "Status": "Enabled"
        },
        "LifecycleConfiguration": {
          "Rules": [
            {
              "Id": "ExpireReplacedBrowserArtifacts",
              "Status": "Enabled",
              "NoncurrentVersionExpiration": {
                "NoncurrentDays": 30
              }
            },
            {
              "Id": "AbortIncompleteUploads",
              "Status": "Enabled",
              "AbortIncompleteMultipartUpload": {
                "DaysAfterInitiation": 7
              }
            }
          ]
        },
        "Tags": [
          {
            "Key": "Name",
            "Value": {
              "Fn::Sub": "keeper-${Environment}-browser"
            }
          },
          {
            "Key": "Environment",
            "Value": {
              "Ref": "Environment"
            }
          },
          {
            "Key": "Application",
            "Value": "magic-collection-keeper"
          }
        ]
      }
    },
    "SnapshotBucket": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "RetainExceptOnCreate",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "OwnershipControls": {
          "Rules": [
            {
              "ObjectOwnership": "BucketOwnerEnforced"
            }
          ]
        },
        "VersioningConfiguration": {
          "Status": "Enabled"
        },
        "LifecycleConfiguration": {
          "Rules": [
            {
              "Id": "ExpireReplacedSourceSnapshots",
              "Status": "Enabled",
              "NoncurrentVersionExpiration": {
                "NoncurrentDays": 90
              }
            },
            {
              "Id": "AbortIncompleteUploads",
              "Status": "Enabled",
              "AbortIncompleteMultipartUpload": {
                "DaysAfterInitiation": 7
              }
            }
          ]
        },
        "Tags": [
          {
            "Key": "Name",
            "Value": {
              "Fn::Sub": "keeper-${Environment}-snapshots"
            }
          },
          {
            "Key": "Environment",
            "Value": {
              "Ref": "Environment"
            }
          },
          {
            "Key": "Application",
            "Value": "magic-collection-keeper"
          }
        ]
      }
    },
    "ArtifactsBucket": {
      "Type": "AWS::S3::Bucket",
      "DeletionPolicy": "RetainExceptOnCreate",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "PublicAccessBlockConfiguration": {
          "BlockPublicAcls": true,
          "BlockPublicPolicy": true,
          "IgnorePublicAcls": true,
          "RestrictPublicBuckets": true
        },
        "BucketEncryption": {
          "ServerSideEncryptionConfiguration": [
            {
              "ServerSideEncryptionByDefault": {
                "SSEAlgorithm": "AES256"
              }
            }
          ]
        },
        "OwnershipControls": {
          "Rules": [
            {
              "ObjectOwnership": "BucketOwnerEnforced"
            }
          ]
        },
        "VersioningConfiguration": {
          "Status": "Enabled"
        },
        "LifecycleConfiguration": {
          "Rules": [
            {
              "Id": "ExpireReplacedDeploymentArtifacts",
              "Status": "Enabled",
              "NoncurrentVersionExpiration": {
                "NoncurrentDays": 30
              }
            },
            {
              "Id": "AbortIncompleteUploads",
              "Status": "Enabled",
              "AbortIncompleteMultipartUpload": {
                "DaysAfterInitiation": 7
              }
            }
          ]
        },
        "Tags": [
          {
            "Key": "Name",
            "Value": {
              "Fn::Sub": "keeper-${Environment}-artifacts"
            }
          },
          {
            "Key": "Environment",
            "Value": {
              "Ref": "Environment"
            }
          },
          {
            "Key": "Application",
            "Value": "magic-collection-keeper"
          }
        ]
      }
    },
    "CatalogRepository": {
      "Type": "AWS::ECR::Repository",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "ImageTagMutability": "IMMUTABLE",
        "ImageScanningConfiguration": {
          "ScanOnPush": true
        },
        "EncryptionConfiguration": {
          "EncryptionType": "AES256"
        },
        "LifecyclePolicy": {
          "LifecyclePolicyText": "{\"rules\":[{\"rulePriority\":1,\"description\":\"Keep the ten most recent catalog job images\",\"selection\":{\"tagStatus\":\"any\",\"countType\":\"imageCountMoreThan\",\"countNumber\":10},\"action\":{\"type\":\"expire\"}}]}"
        },
        "Tags": [
          {
            "Key": "Name",
            "Value": {
              "Fn::Sub": "keeper-${Environment}-catalog"
            }
          },
          {
            "Key": "Environment",
            "Value": {
              "Ref": "Environment"
            }
          },
          {
            "Key": "Application",
            "Value": "magic-collection-keeper"
          }
        ]
      }
    },
    "RecognitionRepository": {
      "Type": "AWS::ECR::Repository",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "ImageTagMutability": "IMMUTABLE",
        "ImageScanningConfiguration": {
          "ScanOnPush": true
        },
        "EncryptionConfiguration": {
          "EncryptionType": "AES256"
        },
        "LifecyclePolicy": {
          "LifecyclePolicyText": "{\"rules\":[{\"rulePriority\":1,\"description\":\"Keep the ten most recent recognition images\",\"selection\":{\"tagStatus\":\"any\",\"countType\":\"imageCountMoreThan\",\"countNumber\":10},\"action\":{\"type\":\"expire\"}}]}"
        },
        "RepositoryPolicyText": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "RecognitionFunctionPullsThisImage",
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": ["ecr:BatchGetImage", "ecr:GetDownloadUrlForLayer"],
              "Condition": {
                "ArnLike": {
                  "aws:sourceArn": {
                    "Fn::Sub": "arn:${AWS::Partition}:lambda:${AWS::Region}:${AWS::AccountId}:function:keeper-${Environment}-recognition"
                  }
                }
              }
            }
          ]
        },
        "Tags": [
          {
            "Key": "Name",
            "Value": {
              "Fn::Sub": "keeper-${Environment}-recognition"
            }
          },
          {
            "Key": "Environment",
            "Value": {
              "Ref": "Environment"
            }
          },
          {
            "Key": "Application",
            "Value": "magic-collection-keeper"
          }
        ]
      }
    },
    "AlarmTopic": {
      "Type": "AWS::SNS::Topic",
      "Properties": {
        "TopicName": {
          "Fn::Sub": "keeper-${Environment}-alarms"
        },
        "DisplayName": {
          "Fn::Sub": "keeper-${Environment} alarms"
        },
        "Tags": [
          {
            "Key": "Environment",
            "Value": {
              "Ref": "Environment"
            }
          },
          {
            "Key": "Application",
            "Value": "magic-collection-keeper"
          }
        ]
      }
    },
    "DatabaseCapacityAlarm": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmName": {
          "Fn::Sub": "keeper-${Environment}-database-capacity"
        },
        "AlarmDescription": "Aurora Serverless v2 capacity stayed at 80% of the configured maximum for 15 minutes; raise DatabaseMaximumCapacity after inspecting the workload.",
        "Namespace": "AWS/RDS",
        "MetricName": "ACUUtilization",
        "Dimensions": [
          {
            "Name": "DBInstanceIdentifier",
            "Value": {
              "Ref": "DatabaseInstance"
            }
          }
        ],
        "Statistic": "Maximum",
        "Unit": "Percent",
        "Period": 300,
        "EvaluationPeriods": 3,
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "Threshold": 80,
        "TreatMissingData": "notBreaching",
        "AlarmActions": [
          {
            "Ref": "AlarmTopic"
          }
        ]
      }
    },
    "DatabaseLogGroup": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": {
          "Fn::Sub": "/aws/rds/cluster/${DatabaseCluster}/postgresql"
        },
        "RetentionInDays": 30,
        "Tags": [
          {
            "Key": "Environment",
            "Value": {
              "Ref": "Environment"
            }
          },
          {
            "Key": "Application",
            "Value": "magic-collection-keeper"
          }
        ]
      }
    },
    "CatalogReaderSecret": {
      "Type": "AWS::SecretsManager::Secret",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "Description": {
          "Fn::Sub": "Read-only Catalog credential of the keeper-${Environment} Aurora cluster"
        },
        "GenerateSecretString": {
          "SecretStringTemplate": {
            "Fn::Sub": "{\"username\":\"${CatalogReaderRoleName}\"}"
          },
          "GenerateStringKey": "password",
          "PasswordLength": 32,
          "ExcludeCharacters": "\"@/\\"
        }
      }
    },
    "UserCardsReaderSecret": {
      "Type": "AWS::SecretsManager::Secret",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "Description": {
          "Fn::Sub": "Read-only UserCards query credential of the keeper-${Environment} Aurora cluster"
        },
        "GenerateSecretString": {
          "SecretStringTemplate": {
            "Fn::Sub": "{\"username\":\"${UserCardsReaderRoleName}\"}"
          },
          "GenerateStringKey": "password",
          "PasswordLength": 32,
          "ExcludeCharacters": "\"@/\\"
        }
      }
    }
  },
  "Outputs": {
    "VpcId": {
      "Description": "Isolated VPC of this environment.",
      "Value": {
        "Ref": "Vpc"
      },
      "Export": {
        "Name": {
          "Fn::Sub": "keeper-${Environment}-vpc-id"
        }
      }
    },
    "PublicSubnetIds": {
      "Description": "Comma-separated public subnets for tasks that need outbound HTTPS.",
      "Value": {
        "Fn::Join": [
          ",",
          [
            {
              "Ref": "PublicSubnetA"
            },
            {
              "Ref": "PublicSubnetB"
            }
          ]
        ]
      },
      "Export": {
        "Name": {
          "Fn::Sub": "keeper-${Environment}-public-subnet-ids"
        }
      }
    },
    "TaskSecurityGroupId": {
      "Description": "Security group of the finite catalog synchronization job: outbound HTTPS only.",
      "Value": {
        "Ref": "TaskSecurityGroup"
      },
      "Export": {
        "Name": {
          "Fn::Sub": "keeper-${Environment}-task-security-group-id"
        }
      }
    },
    "DatabaseClusterArn": {
      "Description": "Aurora cluster for the RDS Data API resourceArn setting.",
      "Value": {
        "Fn::GetAtt": ["DatabaseCluster", "DBClusterArn"]
      },
      "Export": {
        "Name": {
          "Fn::Sub": "keeper-${Environment}-database-cluster-arn"
        }
      }
    },
    "DatabaseName": {
      "Description": "Database inside the Aurora cluster.",
      "Value": {
        "Ref": "DatabaseName"
      },
      "Export": {
        "Name": {
          "Fn::Sub": "keeper-${Environment}-database-name"
        }
      }
    },
    "DatabaseUserCardsWriterSecretArn": {
      "Description": "Secrets Manager reference of the UserCards private-mutation credential.",
      "Value": {
        "Ref": "UserCardsWriterSecret"
      },
      "Export": {
        "Name": {
          "Fn::Sub": "keeper-${Environment}-usercards-writer-secret-arn"
        }
      }
    },
    "DatabaseCatalogWriterSecretArn": {
      "Description": "Secrets Manager reference of the Catalog private-mutation credential.",
      "Value": {
        "Ref": "CatalogWriterSecret"
      },
      "Export": {
        "Name": {
          "Fn::Sub": "keeper-${Environment}-catalog-writer-secret-arn"
        }
      }
    },
    "DatabaseMasterSecretArn": {
      "Description": "RDS-managed master credential. Only the schema bootstrap step of a deployment reads it; no runtime component uses it.",
      "Value": {
        "Fn::GetAtt": ["DatabaseCluster", "MasterUserSecret.SecretArn"]
      }
    },
    "SnapshotBucketName": {
      "Description": "Private source-snapshot bucket.",
      "Value": {
        "Ref": "SnapshotBucket"
      },
      "Export": {
        "Name": {
          "Fn::Sub": "keeper-${Environment}-snapshot-bucket"
        }
      }
    },
    "SnapshotPrefix": {
      "Description": "Key prefix the catalog job streams its provider snapshot from.",
      "Value": {
        "Ref": "SnapshotPrefix"
      },
      "Export": {
        "Name": {
          "Fn::Sub": "keeper-${Environment}-snapshot-prefix"
        }
      }
    },
    "BrowserBucketName": {
      "Description": "Private browser-delivery bucket behind the CloudFront distribution of the service stack.",
      "Value": {
        "Ref": "BrowserBucket"
      },
      "Export": {
        "Name": {
          "Fn::Sub": "keeper-${Environment}-browser-bucket"
        }
      }
    },
    "ArtifactsBucketName": {
      "Description": "Private deployment-artifact bucket that holds the packaged templates and function bundles.",
      "Value": {
        "Ref": "ArtifactsBucket"
      },
      "Export": {
        "Name": {
          "Fn::Sub": "keeper-${Environment}-artifacts-bucket"
        }
      }
    },
    "CatalogRepositoryArn": {
      "Description": "Container repository of the finite catalog job.",
      "Value": {
        "Fn::GetAtt": ["CatalogRepository", "Arn"]
      },
      "Export": {
        "Name": {
          "Fn::Sub": "keeper-${Environment}-catalog-repository-arn"
        }
      }
    },
    "CatalogRepositoryUri": {
      "Description": "Push and image-URI prefix of the catalog job repository.",
      "Value": {
        "Fn::GetAtt": ["CatalogRepository", "RepositoryUri"]
      }
    },
    "CatalogRepositoryName": {
      "Description": "Name the catalog job repository has in ECR, so a push or describe-images command names the repository this stack created instead of a guessed one.",
      "Value": {
        "Ref": "CatalogRepository"
      }
    },
    "RecognitionRepositoryUri": {
      "Description": "Push and image-URI prefix of the recognition repository.",
      "Value": {
        "Fn::GetAtt": ["RecognitionRepository", "RepositoryUri"]
      }
    },
    "RecognitionRepositoryName": {
      "Description": "Name the recognition repository has in ECR, so a push or describe-images command names the repository this stack created instead of a guessed one.",
      "Value": {
        "Ref": "RecognitionRepository"
      }
    },
    "AlarmTopicArn": {
      "Description": "Topic the alarms of this environment publish to. Subscribe an operator endpoint to it.",
      "Value": {
        "Ref": "AlarmTopic"
      },
      "Export": {
        "Name": {
          "Fn::Sub": "keeper-${Environment}-alarm-topic-arn"
        }
      }
    },
    "DatabaseCatalogReaderSecretArn": {
      "Description": "Secrets Manager reference of the Catalog reader credential.",
      "Value": {
        "Ref": "CatalogReaderSecret"
      },
      "Export": {
        "Name": {
          "Fn::Sub": "keeper-${Environment}-catalog-reader-secret-arn"
        }
      }
    },
    "DatabaseUserCardsReaderSecretArn": {
      "Description": "Secrets Manager reference of the UserCards reader credential.",
      "Value": {
        "Ref": "UserCardsReaderSecret"
      },
      "Export": {
        "Name": {
          "Fn::Sub": "keeper-${Environment}-usercards-reader-secret-arn"
        }
      }
    }
  }
}
