{
  "repository": {
    "source": "https://github.com/saintiago/magic-collection-keeper.git",
    "mainBranch": "main"
  },
  "preparation": [
    {
      "executable": "npm",
      "args": ["ci"]
    },
    {
      "executable": "npm",
      "args": ["run", "prepare:validation"]
    }
  ],
  "checks": [
    {
      "name": "validate",
      "command": {
        "executable": "npm",
        "args": ["run", "validate"]
      }
    }
  ],
  "taskSource": {
    "kind": "jira",
    "apiBase": "https://api.atlassian.com/ex/jira/9337c4da-7d33-4c1d-b03c-db207e537f88",
    "project": "KAN",
    "credential": "jira",
    "selection": {
      "query": "project = KAN AND issuetype = Task AND labels = harness-task AND status = \"To Do\"",
      "orderBy": "Rank ASC"
    },
    "fields": {
      "workspacePointer": "customfield_10107",
      "pullRequest": "customfield_10108"
    },
    "statuses": {
      "ready": "To Do",
      "inProgress": "In Progress",
      "review": "In Review",
      "done": "Done"
    },
    "ideas": {
      "selection": {
        "query": "project = KAN AND issuetype = Task AND labels = harness-task AND status = \"Idea\"",
        "orderBy": "Rank ASC"
      },
      "statuses": {
        "submitted": "Idea",
        "active": "Idea Refinement",
        "approved": "Draft",
        "waitingForFeedback": "Waiting for Feedback"
      }
    }
  },
  "delivery": {
    "repository": "saintiago/magic-collection-keeper",
    "baseBranch": "main",
    "reviewCheck": "Nexus Lens review",
    "postMergeChecks": [
      {
        "name": "deploy",
        "workflow": ".github/workflows/deploy.yml"
      }
    ],
    "completion": {
      "pollIntervalSeconds": 30,
      "waitLimitSeconds": 3600
    }
  }
}
