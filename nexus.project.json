      "review": "In Review",
      "done": "Done"
    },
    "ideas": {
      "selection": {
        "query": "project = KAN AND issuetype = Task AND labels = keeper-rebuild AND status = \"Idea\"",
        "orderBy": "Rank ASC"
      },
      "statuses": {
        "submitted": "Idea",
        "active": "Idea Refinement",
        "approved": "Draft",
        "waitingForFeedback": "Waiting for Feedback"
      }
    }
  },
  "delivery": {
    "repository": "saintiago/magic-collection-keeper",
    "baseBranch": "main",
    "reviewCheck": "Nexus Lens review",
    "postMergeChecks": [],
    "completion": {
      "pollIntervalSeconds": 30,
      "waitLimitSeconds": 3600
    }
  }
